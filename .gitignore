# Proprietary Xiaomi binaries, extracted from a Redwood dump and not
# redistributed here. Populate with:
#   ./extract-files.py <dump>              (vendor blobs)
#   tools/import-misound.sh --dump <dump>  (patched MiSound APK)
/proprietary/

# Build products and local scratch.
*.apk
*.dex
*.odex
*.vdex
*.oat
*.zip
*.img
*.log
out/

# Python bytecode caches
__pycache__/
*.pyc
