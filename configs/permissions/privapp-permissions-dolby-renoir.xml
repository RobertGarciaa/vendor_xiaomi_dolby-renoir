<permissions>
    <!-- DolbyControl is /system/priv-app; this allowlist must be on /system.
         AudioService enforces this permission for the audioserver callback. -->
    <privapp-permissions package="org.lineageos.dolby">
        <permission name="android.permission.MODIFY_AUDIO_ROUTING" />
    </privapp-permissions>
</permissions>
