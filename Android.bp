cc_prebuilt_binary {
    name: "vendor.dolby.hardware.dms@2.0-service",
    owner: "xiaomi",
    vintf_fragments: ["proprietary/vendor/etc/vintf/manifest/manifest_vendor.dolby.hardware.dms.xml"],
    target: {
        android: {
            srcs: [
                "proprietary/vendor/bin/hw/vendor.dolby.hardware.dms@2.0-service",
            ],
            shared_libs: [
                "liblog",
                "libutils",
                "libhidlbase",
                "libdapparamstorage",
                "libdlbdsservice",
                "vendor.dolby.hardware.dms@2.0",
                "vendor.dolby.hardware.dms@2.0-impl",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "64",
    strip: {
        none: true,
    },
    prefer: true,
    relative_install_path: "hw",
    soc_specific: true,
}

// Keep extraction hashes meaningful: derive tuning without editing OTA blobs.
python_binary_host {
    name: "renoir_dax_tuning_generator",
    main: "tools/gen-renoir-dax.py",
    srcs: ["tools/gen-renoir-dax.py"],
}

genrule {
    name: "renoir_dax_static_v1",
    tools: ["renoir_dax_tuning_generator"],
    srcs: ["proprietary/vendor/etc/dolby/dax-default.xml"],
    out: ["dax-renoir-static-v1.xml"],
    cmd: "$(location renoir_dax_tuning_generator) --stock $(in) --out $(out)",
}

// Install the generated renoir candidate at the original DMS lookup path.
prebuilt_etc {
    name: "dolby-dax-default.xml",
    owner: "xiaomi",
    src: ":renoir_dax_static_v1",
    filename: "dax-default.xml",
    sub_dir: "dolby",
    soc_specific: true,
}

prebuilt_etc {
    name: "vendor.dolby.hardware.dms@2.0-service.rc",
    owner: "xiaomi",
    src: "configs/init/dolby.rc",
    filename: "vendor.dolby.hardware.dms@2.0-service.rc",
    sub_dir: "init",
    soc_specific: true,
}

// Redwood MiSound, rebuilt with the software DAP UUIDs by
// tools/patch-misound.py and added to the tree by
// tools/import-misound.sh. Not committed: it is a proprietary Xiaomi APK, and
// the patched output is derived. The input hash is pinned; output UUIDs,
// DEX ordering and signature are verified by those tools.
//
// certificate: "platform" re-signs the prebuilt with the platform key. That is
// required because the patched APK must keep the same certificate identity as
// the rest of the system image; it is not shipped with Xiaomi's signature.
// Fail early if the prebuilt was generated before the null-selection fix.
python_binary_host {
    name: "renoir_misound_apk_verifier",
    main: "tools/misound_apk_contract.py",
    srcs: ["tools/misound_apk_contract.py"],
}

genrule {
    name: "renoir_misound_verified_apk",
    tools: ["renoir_misound_apk_verifier"],
    srcs: ["proprietary/product/app/MiSound/MiSound.apk"],
    out: ["MiSound-verified.apk"],
    cmd: "$(location renoir_misound_apk_verifier) --input $(in) --output $(out)",
}

android_app_import {
    name: "MiSound",
    owner: "xiaomi",
    apk: ":renoir_misound_verified_apk",
    certificate: "platform",
    privileged: false,
    dex_preopt: {
        enabled: false,
    },
    // The APK already contains a patched classes.dex and a shim classes2.dex;
    // preopting a hand-patched multidex APK adds risk without benefit.
    presigned: false,
    product_specific: true,
}

// DMS was built against AHandler's VNDK30 layout. Isolate its original
// provider instead of letting Android 17 write new fields into the old object.
python_binary_host {
    name: "renoir_dms_foundation_fixup",
    main: "tools/dms_foundation_compat.py",
    srcs: ["tools/dms_foundation_compat.py"],
}

genrule {
    name: "renoir_dms_compat_consumer",
    tools: ["renoir_dms_foundation_fixup"],
    srcs: ["proprietary/vendor/lib64/libdlbdsservice.so"],
    out: ["libdlbdsservice.so"],
    cmd: "$(location renoir_dms_foundation_fixup) --mode consumer --input $(in) --output $(out)",
}

genrule {
    name: "renoir_dms_compat_provider",
    tools: ["renoir_dms_foundation_fixup"],
    srcs: ["proprietary/compat/vndk30/lib64/libstagefright_foundation.so"],
    out: ["libsf_dolby_renoir.so"],
    cmd: "$(location renoir_dms_foundation_fixup) --mode provider --input $(in) --output $(out)",
}

cc_prebuilt_library_shared {
    name: "libsf_dolby_renoir",
    owner: "xiaomi",
    srcs: [":renoir_dms_compat_provider"],
    shared_libs: [
        "libutils",
        "libcutils",
        "liblog",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    prefer: true,
    soc_specific: true,
}
