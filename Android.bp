//
// Dolby Atmos (Redwood HyperOS software DAP) vendor components.
//
// Blob provenance is recorded in proprietary-files.txt and README.md.
// Only 64-bit variants are shipped: audioserver, the effects
// factory and the DMS HAL service are 64-bit on this product, so 32-bit
// libswdap/libdapparamstorage/DMS would be dead weight with an unreviewed
// linker surface.
//

soong_namespace {
}

cc_prebuilt_library_shared {
    name: "libdapparamstorage",
    owner: "xiaomi",
    strip: {
        none: true,
    },
    target: {
        android: {
            srcs: [
                "proprietary/vendor/lib64/libdapparamstorage.so",
            ],
            shared_libs: [
                "libcutils",
                "libutils",
                "liblog",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "64",
    prefer: true,
    soc_specific: true,
}

cc_prebuilt_library_shared {
    name: "libdlbdsservice",
    owner: "xiaomi",
    strip: {
        none: true,
    },
    target: {
        android: {
            srcs: [
                "proprietary/vendor/lib64/libdlbdsservice.so",
            ],
            shared_libs: [
                "libutils",
                "libstagefright_foundation",
                "liblog",
                "libxml2",
                "libcrypto",
                "libdapparamstorage",
                "libsqlite",
                "libhidlbase",
                "vendor.dolby.hardware.dms@2.0",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "64",
    prefer: true,
    soc_specific: true,
}

cc_prebuilt_library_shared {
    name: "vendor.dolby.hardware.dms@2.0",
    owner: "xiaomi",
    strip: {
        none: true,
    },
    target: {
        android: {
            srcs: [
                "proprietary/vendor/lib64/vendor.dolby.hardware.dms@2.0.so",
            ],
            shared_libs: [
                "libhidlbase",
                "liblog",
                "libutils",
                "libcutils",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "64",
    prefer: true,
    soc_specific: true,
}

cc_prebuilt_library_shared {
    name: "vendor.dolby.hardware.dms@2.0-impl",
    owner: "xiaomi",
    strip: {
        none: true,
    },
    target: {
        android: {
            srcs: [
                "proprietary/vendor/lib64/vendor.dolby.hardware.dms@2.0-impl.so",
            ],
            shared_libs: [
                "libhidlbase",
                "libutils",
                "liblog",
                "libdapparamstorage",
                "libdlbdsservice",
                "vendor.dolby.hardware.dms@2.0",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "64",
    prefer: true,
    soc_specific: true,
}

cc_prebuilt_library_shared {
    name: "libswdap",
    owner: "xiaomi",
    strip: {
        none: true,
    },
    target: {
        android: {
            srcs: [
                "proprietary/vendor/lib64/soundfx/libswdap.so",
            ],
            shared_libs: [
                "liblog",
                "libutils",
                "libcutils",
                "libaudioutils",
                "libdapparamstorage",
                "libhidlbase",
                "vendor.dolby.hardware.dms@2.0",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "64",
    relative_install_path: "soundfx",
    prefer: true,
    soc_specific: true,
}

cc_prebuilt_binary {
    name: "vendor.dolby.hardware.dms@2.0-service",
    owner: "xiaomi",
    vintf_fragments: ["proprietary/vendor/etc/vintf/manifest/manifest_vendor.dolby.hardware.dms.xml"],
    target: {
        android: {
            srcs: [
                "proprietary/vendor/bin/hw/vendor.dolby.hardware.dms@2.0-service",
            ],
            shared_libs: [
                "liblog",
                "libutils",
                "libhidlbase",
                "libdapparamstorage",
                "libdlbdsservice",
                "vendor.dolby.hardware.dms@2.0",
                "vendor.dolby.hardware.dms@2.0-impl",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "64",
    strip: {
        none: true,
    },
    prefer: true,
    relative_install_path: "hw",
    soc_specific: true,
}

// DAX tuning database consumed by libdlbdsservice.
prebuilt_etc {
    name: "dolby-dax-default.xml",
    owner: "xiaomi",
    src: "proprietary/vendor/etc/dolby/dax-default.xml",
    filename: "dax-default.xml",
    sub_dir: "dolby",
    soc_specific: true,
}

prebuilt_etc {
    name: "vendor.dolby.hardware.dms@2.0-service.rc",
    owner: "xiaomi",
    src: "configs/init/dolby.rc",
    filename: "vendor.dolby.hardware.dms@2.0-service.rc",
    sub_dir: "init",
    soc_specific: true,
}
